#!/usr/bin/env bash
# validate_slug_scripts - check that every post_slug implementation gives
# the same slug for each line of a text file
set -euo pipefail
shopt -s inherit_errexit
declare -rx PATH=/usr/local/bin:/usr/bin:/bin

#shellcheck disable=SC2155  # exit-on-error catches realpath failure
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*} SCRIPT_NAME=${SCRIPT_PATH##*/}
declare -r ROOT_DIR=${SCRIPT_DIR%/*}

# Implementations in test order; the first one available is the reference.
declare -ra ALL_IMPLS=(py js php bash c)
# Interpreter each wrapper needs ('c' is built instead; see build_c)
declare -rA INTERPRETER=([py]=python3 [js]=node [php]=php [bash]=bash)
# Driver file extension; the bash driver is an executable, so .sh (BCS0106)
declare -rA DRIVER_EXT=([py]=py [js]=js [php]=php [bash]=sh)

declare -i VERBOSE=1 MAX_LEN=0
declare -- TEXTFILE='' TMP_DIR=''
declare -a SEPS=() CASES=() IMPLS=() INPUT=()
declare -a MISMATCH=()     # indexed by line number; set when slugs differ
declare -A RUNNER=()       # implementation -> command

_msg()    { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
info()    { ((VERBOSE)) || return 0; _msg '◉' "$@"; }
success() { ((VERBOSE)) || return 0; _msg '✓' "$@"; }
warn()    { _msg '▲' "$@"; }
error()   { _msg '✗' "$@"; }
die()     { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

show_help() {
  cat <<HELP
$SCRIPT_NAME - check that all post_slug implementations agree

Runs each available implementation (${ALL_IMPLS[*]}) once over the whole
of textfile, for every separator and case setting, and reports each line
where the slugs differ.

Usage: $SCRIPT_NAME [-q] textfile [max_len [seps [cases]]]

  textfile   Text file, one input string per line (required)
  max_len    Maximum slug length; default 0 (unlimited)
  seps       Separator characters, comma-delimited; default '_,-'
  cases      Case settings, comma-delimited, 1 = preserve; default '0,1'

Options, recognised before textfile only:
  -q, --quiet   Report mismatches only
  -h, --help    Show this help

Without -q, every line is printed with each implementation's slug.

Exit status: 0 all slugs agree; 1 slugs differ or an implementation
failed; 2 usage error; 3 textfile not found; 13 textfile not readable;
18 fewer than two implementations available; 22 invalid argument.

Examples:
  $SCRIPT_NAME datasets/headlines.txt
  $SCRIPT_NAME datasets/headlines.txt 0 '-' 1
  $SCRIPT_NAME -q datasets/booktitles.txt 127 '-' 0
  $SCRIPT_NAME datasets/booktitles.txt 0 '_,-,|' 0,1
HELP
}

# parse_args textfile [max_len [seps [cases]]]
parse_args() {
  local -- item
  local -a list

  [[ -e $1 ]] || die 3 "File not found ${1@Q}"
  [[ -f $1 ]] || die 22 "Not a regular file ${1@Q}"
  [[ -r $1 ]] || die 13 "Cannot read ${1@Q}"
  TEXTFILE=$(realpath -- "$1") || die 1 "Cannot resolve ${1@Q}"

  [[ ${2:-0} =~ ^[0-9]+$ ]] || die 22 "max_len must be a non-negative integer, not ${2@Q}"
  MAX_LEN=10#${2:-0}

  IFS=',' read -ra list <<< "${3:-_,-}"
  for item in "${list[@]}"; do
    [[ -n $item ]] || continue
    [[ $item == [[:ascii:]] ]] || die 22 "A separator must be one ASCII character, not ${item@Q}"
    SEPS+=("$item")
  done
  ((${#SEPS[@]})) || die 22 'No separator given'

  IFS=',' read -ra list <<< "${4:-0,1}"
  for item in "${list[@]}"; do
    [[ -n $item ]] || continue
    [[ $item == [01] ]] || die 22 "A case setting must be 0 or 1, not ${item@Q}"
    CASES+=("$item")
  done
  ((${#CASES[@]})) || die 22 'No case setting given'
}

# Rebuild the C binary when its sources changed, so a stale build is never
# the one tested. Without make and cc, fall back to an existing build.
build_c() {
  local -- bin=$ROOT_DIR/c/_post_slug
  if command -v make >/dev/null && command -v cc >/dev/null; then
    if ! make -s -C "$ROOT_DIR"/c build >/dev/null; then
      warn 'C build failed; post_slug.c not tested'
      return 1
    fi
  elif [[ -x $bin ]]; then
    warn "make or cc not found; testing the existing build ${bin@Q}"
  else
    warn 'make or cc not found and no C build; post_slug.c not tested'
    return 1
  fi
  RUNNER[c]=$bin
}

find_impls() {
  local -- impl
  for impl in "${ALL_IMPLS[@]}"; do
    if [[ $impl == c ]]; then
      build_c || continue
    elif command -v "${INTERPRETER[$impl]}" >/dev/null; then
      RUNNER[$impl]=$SCRIPT_DIR/_post_slug.${DRIVER_EXT[$impl]}
    else
      warn "${INTERPRETER[$impl]} not found; post_slug.$impl not tested"
      continue
    fi
    [[ -e ${RUNNER[$impl]} ]] || die 3 "Driver not found ${RUNNER[$impl]@Q}"
    [[ -x ${RUNNER[$impl]} ]] || die 13 "Not executable ${RUNNER[$impl]@Q}"
    IMPLS+=("$impl")
  done
  ((${#IMPLS[@]} >= 2)) || die 18 'Fewer than two implementations available; nothing to compare'
}

# check_combo sep_char preserve_case - run every implementation once over
# TEXTFILE, then compare the slugs line by line
check_combo() {
  local -- sep=$1 pc=$2 impl ref=${IMPLS[0]}
  local -i i n=${#INPUT[@]} differ=0 same
  local -a out
  local -A slug=()

  for impl in "${IMPLS[@]}"; do
    "${RUNNER[$impl]}" --stdin "$sep" "$pc" "$MAX_LEN" < "$TEXTFILE" > "$TMP_DIR/$impl" \
      || die 1 "post_slug.$impl failed (sep=${sep@Q} case=$pc max_len=$MAX_LEN)"
  done
  for impl in "${IMPLS[@]:1}"; do
    cmp -s -- "$TMP_DIR/$ref" "$TMP_DIR/$impl" || differ=1
  done

  for impl in "${IMPLS[@]}"; do
    mapfile -t out < "$TMP_DIR/$impl"
    ((${#out[@]} == n)) || die 1 "post_slug.$impl gave ${#out[@]} slugs for $n lines"
    ((differ || VERBOSE)) || continue
    for i in "${!out[@]}"; do
      slug[$impl,$i]=${out[i]}
    done
  done
  ((differ || VERBOSE)) || return 0

  for ((i = 0; i < n; i+=1)); do
    same=1
    for impl in "${IMPLS[@]:1}"; do
      [[ ${slug[$impl,$i]} == "${slug[$ref,$i]}" ]] || { same=0; break; }
    done
    if ((VERBOSE)); then
      printf '%5d|%s|%s|%s: %s\n' $((i + 1)) "$sep" "$pc" "$MAX_LEN" "${INPUT[i]}"
      for impl in "${IMPLS[@]}"; do
        printf '%5s: %s\n' "$impl" "${slug[$impl,$i]}"
      done
    fi
    if ((!same)); then
      MISMATCH[i + 1]=1
      error "Slugs differ at line $((i + 1)) (sep=${sep@Q} case=$pc max_len=$MAX_LEN)"
      >&2 printf '%5s: %s\n' input "${INPUT[i]}"
      for impl in "${IMPLS[@]}"; do
        >&2 printf '%5s: %s\n' "$impl" "${slug[$impl,$i]}"
      done
    fi
  done
}

# Offer to open TEXTFILE at each mismatching line, when run from a terminal
offer_edit() {
  [[ -t 0 && -t 1 ]] || return 0
  local -- line_no yn
  local -a editor
  read -ra editor <<< "${EDITOR:-nano}"
  for line_no in "${!MISMATCH[@]}"; do
    read -r -p "Edit ${TEXTFILE@Q} at line $line_no? (y/n) " yn
    [[ ${yn,,} == y ]] || continue
    "${editor[@]}" "+$line_no" "$TEXTFILE" || warn "Editor ${editor[0]@Q} failed"
  done
}

cleanup() {
  local -i exitcode=${1:-$?}
  trap - SIGINT SIGTERM EXIT
  [[ -z $TMP_DIR ]] || rm -rf -- "$TMP_DIR" ||:
  exit "$exitcode"
}

main() {
  local -- sep pc summary
  local -i combos

  while (($#)); do case $1 in
    -q|--quiet) VERBOSE=0 ;;
    -h|--help)  show_help; exit 0 ;;
    --)         shift; break ;;
    -[qh]?*)    set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
    -?*)        die 22 "Invalid option ${1@Q}" ;;
    *)          break ;;
  esac; shift; done
  readonly VERBOSE

  (($#)) || { >&2 show_help; die 2; }
  (($# <= 4)) || die 2 "Too many arguments; see '$SCRIPT_NAME --help'"
  parse_args "$@"
  readonly TEXTFILE MAX_LEN SEPS CASES
  find_impls
  mapfile -t INPUT < "$TEXTFILE"

  # One trap per signal: at a signal, $? is the last command's status (often
  # 0), and a killed run must not report a pass.
  trap 'cleanup $?' EXIT
  trap 'cleanup 130' SIGINT
  trap 'cleanup 143' SIGTERM
  TMP_DIR=$(mktemp -d) || die 1 'Cannot create a temporary directory'

  summary="${TEXTFILE@Q}: ${#INPUT[@]} lines; max_len $MAX_LEN; separators (${SEPS[*]})"
  summary+="; cases (${CASES[*]}); implementations (${IMPLS[*]})"
  info "$summary"
  for sep in "${SEPS[@]}"; do
    for pc in "${CASES[@]}"; do
      check_combo "$sep" "$pc"
    done
  done

  if ((${#MISMATCH[@]} == 0)); then
    combos=$((${#SEPS[@]} * ${#CASES[@]}))
    success "All ${#IMPLS[@]} implementations agree on all ${#INPUT[@]} lines in $combos combinations"
    return 0
  fi
  error "Slugs differ on ${#MISMATCH[@]} of ${#INPUT[@]} lines: ${!MISMATCH[*]}"
  offer_edit
  return 1
}

main "$@"
#fin
